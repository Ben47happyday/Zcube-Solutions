# Postgres connection string for order storage (tables live in their own
# "matchihomeware" schema, so this database can be shared with other
# apps/schemas without colliding). Required even for local dev.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Microsoft Graph app-only credentials used to SEND order notification
# emails, from an Azure AD app registration with Mail.Send permission on
# the sender mailbox.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=orders@yourcompany.com

# Who receives the order notification emails
NOTIFY_EMAIL=you@yourcompany.com

# Password for the /admin orders dashboard
ADMIN_PASSWORD=change-this-password

# Leave unset — the app serves at "/". Only needed if mounting this app
# under a sub-path of another site. See render.yaml.
NEXT_PUBLIC_BASE_PATH=
